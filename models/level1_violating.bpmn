<?xml version="1.0" ?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_level1_violating" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Compliance Verification Studio BPMN 2.0 Engine">
  <bpmn:collaboration id="Collaboration_level1">
    <bpmn:participant id="Participant_Portal" name="Customer / Borrower Portal" processRef="Process_level1_Portal"/>
    <bpmn:participant id="Participant_Bank" name="🏦 Pool: Commercial Lending Institution (Single-Tier Process)" processRef="Process_level1_Bank"/>
    <bpmn:messageFlow id="MsgFlow_1" sourceRef="p_submit" targetRef="t_recv"/>
    <bpmn:messageFlow id="MsgFlow_2" sourceRef="t_app" targetRef="p_receive"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_level1_Portal" isExecutable="false">
    <bpmn:startEvent id="p_start" name="Start"/>
    <bpmn:userTask id="p_submit" name="Access Portal &amp; Submit Application"/>
    <bpmn:receiveTask id="p_receive" name="Receive Official Decision Letter"/>
    <bpmn:endEvent id="p_end" name="Completed"/>
  </bpmn:process>
  <bpmn:process id="Process_level1_Bank" isExecutable="true">
    <bpmn:laneSet id="LaneSet_level1">
      <bpmn:lane id="lane_intake" name="Front-Office Desk">
        <bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>xor_split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_risk" name="Credit &amp; Risk Dept">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_officer" name="Loan Officer">
        <bpmn:flowNodeRef>xor_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="t_recv" name="Receive Application &amp; Create Loan Dossier"/>
    <bpmn:exclusiveGateway id="xor_split" name=""/>
    <bpmn:serviceTask id="t_check" name="Mandatory Credit Check (Prerequisite)"/>
    <bpmn:exclusiveGateway id="xor_dec" name="Eligible?"/>
    <bpmn:userTask id="t_app" name="Loan Officer Approve Loan"/>
    <bpmn:userTask id="t_rej" name="Loan Officer Reject Loan"/>
    <bpmn:endEvent id="end_app" name="Approved"/>
    <bpmn:endEvent id="end_rej" name="Rejected"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="p_start" targetRef="p_submit"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="p_receive" targetRef="p_end"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_recv" targetRef="xor_split"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="xor_split" targetRef="t_check"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t_check" targetRef="xor_dec"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="xor_dec" targetRef="t_app" name="Eligible"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="xor_dec" targetRef="t_rej" name="Ineligible"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t_app" targetRef="end_app"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="t_rej" targetRef="end_rej"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="xor_split" targetRef="t_app" name="⚠️ Skip Credit Check" xsi:type="bpmn:tViolationFlow"/>
  </bpmn:process>
</bpmn:definitions>
