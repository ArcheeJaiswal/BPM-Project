<?xml version="1.0" ?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net_level3_compliant" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>Level 3: Advanced (Multi-Gateway: Inclusive, Parallel &amp; Exclusive) - Compliant Variant</text>
    </name>
    <page id="page_0">
      <place id="p_start">
        <name>
          <text>p_start (Application Submitted)</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="p_split">
        <name>
          <text>p_split (Ready for Parallel Vetting)</text>
        </name>
      </place>
      <place id="p_cred_wait">
        <name>
          <text>p_cred_wait (Awaiting Credit Risk Check)</text>
        </name>
      </place>
      <place id="p_cred_done">
        <name>
          <text>p_cred_done (Credit Check Finished)</text>
        </name>
      </place>
      <place id="p_sec_wait">
        <name>
          <text>p_sec_wait (Awaiting Security Evaluation)</text>
        </name>
      </place>
      <place id="p_prop_wait">
        <name>
          <text>p_prop_wait (Awaiting Property Appraisal)</text>
        </name>
      </place>
      <place id="p_guar_wait">
        <name>
          <text>p_guar_wait (Awaiting Guarantor Audit)</text>
        </name>
      </place>
      <place id="p_prop_skip">
        <name>
          <text>p_prop_skip (Property Appraisal Not Required)</text>
        </name>
      </place>
      <place id="p_guar_skip">
        <name>
          <text>p_guar_skip (Guarantor Audit Not Required)</text>
        </name>
      </place>
      <place id="p_prop_done">
        <name>
          <text>p_prop_done (Property Appraisal Finished)</text>
        </name>
      </place>
      <place id="p_guar_done">
        <name>
          <text>p_guar_done (Guarantor Audit Finished)</text>
        </name>
      </place>
      <place id="p_sec_done">
        <name>
          <text>p_sec_done (Security Clearance Complete)</text>
        </name>
      </place>
      <place id="p_evaluated">
        <name>
          <text>p_evaluated (Audits Synchronized / Risk Evaluation)</text>
        </name>
      </place>
      <place id="p_rework">
        <name>
          <text>p_rework (Additional Documents Requested)</text>
        </name>
      </place>
      <place id="p_escalated">
        <name>
          <text>p_escalated (Escalated to Committee)</text>
        </name>
      </place>
      <place id="p_comm_vetted">
        <name>
          <text>p_comm_vetted (Senior Committee Review Completed)</text>
        </name>
      </place>
      <place id="p_end">
        <name>
          <text>p_end (Process Terminated)</text>
        </name>
      </place>
      <transition id="t_submit">
        <name>
          <text>Submit Application</text>
        </name>
      </transition>
      <transition id="t_and_split">
        <name>
          <text>AND-Split (Fork Concurrency)</text>
        </name>
      </transition>
      <transition id="t_credit">
        <name>
          <text>Credit Risk Assessment</text>
        </name>
      </transition>
      <transition id="t_or_prop">
        <name>
          <text>OR-Split: Property Collateral Only</text>
        </name>
      </transition>
      <transition id="t_or_guar">
        <name>
          <text>OR-Split: Corporate Guarantor Only</text>
        </name>
      </transition>
      <transition id="t_or_both">
        <name>
          <text>OR-Split: Both Collateral &amp; Guarantor</text>
        </name>
      </transition>
      <transition id="t_prop_appraisal">
        <name>
          <text>Real Estate Asset Appraisal</text>
        </name>
      </transition>
      <transition id="t_guar_audit">
        <name>
          <text>Corporate Guarantor Audit</text>
        </name>
      </transition>
      <transition id="t_or_join_prop">
        <name>
          <text>OR-Join: Property Synchronized</text>
        </name>
      </transition>
      <transition id="t_or_join_guar">
        <name>
          <text>OR-Join: Guarantor Synchronized</text>
        </name>
      </transition>
      <transition id="t_or_join_both">
        <name>
          <text>OR-Join: Both Synchronized</text>
        </name>
      </transition>
      <transition id="t_and_join">
        <name>
          <text>AND-Join (Synchronize Audits)</text>
        </name>
      </transition>
      <transition id="t_low_app">
        <name>
          <text>Standard Manager Approval</text>
        </name>
      </transition>
      <transition id="t_direct_rej">
        <name>
          <text>Reject Loan</text>
        </name>
      </transition>
      <transition id="t_req_docs">
        <name>
          <text>Request Additional Documents (Rework)</text>
        </name>
      </transition>
      <transition id="t_resubmit">
        <name>
          <text>Resubmit Updated Documents</text>
        </name>
      </transition>
      <transition id="t_escalate">
        <name>
          <text>Escalate to Senior Risk Committee</text>
        </name>
      </transition>
      <transition id="t_comm_rev">
        <name>
          <text>Senior Committee Review</text>
        </name>
      </transition>
      <transition id="t_comm_app">
        <name>
          <text>Committee Approve Loan</text>
        </name>
      </transition>
      <transition id="t_comm_rej">
        <name>
          <text>Committee Reject Loan</text>
        </name>
      </transition>
      <arc id="arc_1" source="p_start" target="t_submit">
        <inscription>
          <text>1</text>
        </inscription>
      </arc>
