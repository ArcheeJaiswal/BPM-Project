      "t_submit": {
        "label": "Submit Application",
        "inputs": [
          "p_start"
        ],
        "outputs": [
          "p_split"
        ],
        "type": "standard",
        "lane": "Lane 1: Intake Desk"
      },
      "t_and_split": {
        "label": "AND-Split (Fork)",
        "inputs": [
          "p_split"
        ],
        "outputs": [
          "p_cred_wait",
          "p_kyc_wait"
        ],
        "type": "standard",
        "lane": "Lane 1: Intake Desk"
      },
      "t_credit": {
        "label": "Credit Risk Assessment",
        "inputs": [
          "p_cred_wait"
